# ---------------------------------------------------------------------------
# Osprey backend configuration. Copy to `.env`. All vars use the OSPREY_ prefix.
# ---------------------------------------------------------------------------

# App
OSPREY_ENV=dev                          # dev | prod
OSPREY_DEBUG=true
OSPREY_LOG_LEVEL=INFO

# Security — GENERATE REAL VALUES BEFORE PRODUCTION.
#   secret key (JWT signing):   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   encryption key (token vault, urlsafe base64 of 32 bytes):
#                               python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OSPREY_SECRET_KEY=dev-only-insecure-change-me
OSPREY_ENCRYPTION_KEY=dev-only-insecure-change-me
OSPREY_ACCESS_TOKEN_TTL_MINUTES=60
OSPREY_REFRESH_TOKEN_TTL_DAYS=14

# The API REFUSES TO START with OSPREY_ENV=prod and any of the defaults above.
# See docs/operations.md for the full pre-deploy checklist.

# Origins allowed to call the API. Required in production (a "*" is rejected --
# it cannot be combined with credentialed requests). Dev allows everything.
# OSPREY_CORS_ALLOW_ORIGINS=["https://osprey.example.com"]

# External URL, used for webhook callbacks and the SSO redirect.
OSPREY_PUBLIC_BASE_URL=

# HTTP hardening
OSPREY_SECURITY_HEADERS_ENABLED=true
OSPREY_MAX_REQUEST_BODY_BYTES=10485760
# Turn ON behind an ingress/load balancer you control, and only then: it makes the
# app trust X-Forwarded-For, which a direct client could otherwise forge to pick
# its own rate-limit bucket.
OSPREY_TRUST_PROXY_HEADERS=false

# Rate limiting.  auto = Redis when reachable, per-process counters otherwise.
# With more than one API replica only "redis" enforces a global limit.
OSPREY_RATE_LIMIT_ENABLED=true
OSPREY_RATE_LIMIT_BACKEND=auto
OSPREY_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
OSPREY_RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
OSPREY_RATE_LIMIT_LOGIN_PER_MINUTE=10
OSPREY_LOGIN_MAX_FAILURES=10
OSPREY_LOGIN_LOCKOUT_MINUTES=15

# Password policy. Iterations may go below 390,000 only outside production.
OSPREY_PASSWORD_MIN_LENGTH=12
OSPREY_PASSWORD_REQUIRE_CLASSES=3
OSPREY_PASSWORD_HASH_ITERATIONS=390000

# Tenant isolation (Postgres row-level security). Requires migration 0002 AND an
# ordinary DB role -- a superuser bypasses RLS entirely and this silently does
# nothing. Check /admin/security/tenant-isolation after enabling.
OSPREY_RLS_ENABLED=false

# ---- Single sign-on (OIDC) ------------------------------------------------
OSPREY_OIDC_ENABLED=false
OSPREY_OIDC_ISSUER=                     # e.g. https://login.microsoftonline.com/<tenant>/v2.0
OSPREY_OIDC_CLIENT_ID=
OSPREY_OIDC_CLIENT_SECRET=
# Where the IdP sends the browser back. This is YOUR CLIENT's callback route, not
# an Osprey API path: the client reads ?code=&state= from its own query string and
# POSTs them to /auth/sso/callback. Register this exact value with the provider.
#   web client:  https://osprey.example.com/auth/callback
#   desktop app: nothing to set -- it binds a loopback port per sign-in (RFC 8252)
#                and passes it on /auth/sso/start; register http://127.0.0.1 with
#                the provider as a native redirect.
OSPREY_OIDC_REDIRECT_URL=
# Empty = accept any domain the IdP verifies. Set this for a multi-tenant IdP
# (e.g. Microsoft "common"), where "verified by the IdP" means very little.
OSPREY_OIDC_ALLOWED_EMAIL_DOMAINS=[]
# With auto-provision on, anyone the IdP will authenticate gets an account.
OSPREY_OIDC_AUTO_PROVISION=false
OSPREY_OIDC_DEFAULT_ORG_ID=
OSPREY_OIDC_DEFAULT_ROLE=viewer

# ---- SCIM 2.0 provisioning ------------------------------------------------
# Tokens are minted per-org via POST /orgs/current/scim-tokens, not here.
OSPREY_SCIM_ENABLED=false

# ---- Data retention (days; 0 = keep forever) ------------------------------
# Open items are never purged at any age. Preview before enabling:
#   GET /orgs/current/retention/preview
OSPREY_RETENTION_SIGNAL_DAYS=0
OSPREY_RETENTION_ITEM_DAYS=0
# Audit history is hash-chained; purging truncates the oldest records only.
OSPREY_RETENTION_AUDIT_DAYS=0

# ---- Metrics --------------------------------------------------------------
# /metrics leaks tenant counts and error rates. Set a token, or keep the port
# off the internet.
OSPREY_METRICS_ENABLED=true
OSPREY_METRICS_TOKEN=

# ---- Tracing (optional; needs the `otel` extra) ---------------------------
OSPREY_OTEL_ENABLED=false
OSPREY_OTEL_EXPORTER_OTLP_ENDPOINT=

# Database — SQLite by default (zero infra). Use Postgres+pgvector in production:
#   OSPREY_DATABASE_URL=postgresql+asyncpg://osprey:osprey@localhost:5432/osprey
OSPREY_DATABASE_URL=sqlite+aiosqlite:///./osprey.db

# Redis (queue + cache). Optional for local single-process dev.
OSPREY_REDIS_URL=redis://localhost:6379/0

# AI layer:  deterministic (offline default, no key needed) | claude | openai | ollama
OSPREY_AI_PROVIDER=deterministic
OSPREY_ANTHROPIC_API_KEY=
OSPREY_ANTHROPIC_MODEL=claude-sonnet-5
# Only for OSPREY_AI_PROVIDER=openai. Never reuses the Anthropic key.
OSPREY_OPENAI_API_KEY=
OSPREY_OPENAI_MODEL=gpt-4o
# Optional: an OpenAI-compatible gateway. Blank uses OpenAI directly.
OSPREY_OPENAI_BASE_URL=
OSPREY_OLLAMA_HOST=http://localhost:11434
OSPREY_OLLAMA_MODEL=llama3.1

# Embeddings:  hashing (offline default) | (future: real model providers)
OSPREY_EMBEDDING_PROVIDER=hashing
OSPREY_EMBEDDING_DIM=256

# Ingestion / clustering
OSPREY_CLUSTER_SIMILARITY_THRESHOLD=0.82
OSPREY_HOTLIST_TOP_N=25

# Connectors (Tier 1 OAuth apps) — leave blank unless enabling that source.
# The desktop app drives user consent; these are the server-side app credentials.
OSPREY_MSGRAPH_CLIENT_ID=
OSPREY_MSGRAPH_CLIENT_SECRET=
OSPREY_MSGRAPH_TENANT_ID=
OSPREY_GOOGLE_CLIENT_ID=
OSPREY_GOOGLE_CLIENT_SECRET=
OSPREY_PROCORE_CLIENT_ID=
OSPREY_PROCORE_CLIENT_SECRET=
# Autodesk Construction Cloud (APS app, PKCE; the secret is optional for a public client)
OSPREY_ACC_CLIENT_ID=
OSPREY_ACC_CLIENT_SECRET=
OSPREY_WEBHOOK_HMAC_SECRET=dev-only-insecure-change-me

# Push notifications:  logging (offline default) | auto | apns | fcm
OSPREY_PUSH_PROVIDER=logging
# APNs (token-based auth) — paste the .p8 contents into OSPREY_APNS_PRIVATE_KEY
OSPREY_APNS_TEAM_ID=
OSPREY_APNS_KEY_ID=
OSPREY_APNS_PRIVATE_KEY=
OSPREY_APNS_BUNDLE_ID=dev.ospreyhq.desktop
OSPREY_APNS_USE_SANDBOX=false
# FCM (HTTP v1) — inline service-account JSON
OSPREY_FCM_PROJECT_ID=
OSPREY_FCM_SERVICE_ACCOUNT_JSON=

# Feature flags
OSPREY_FEATURE_AI_SIFT=true
OSPREY_FEATURE_SCRIPTS=true
