# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# App
.env
*.db
*.sqlite3
osprey.db*
osprey-demo.db*
demo/
/exports_tmp/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
# Per-machine Claude Code config: launch.json holds absolute local paths and
# settings.local.json is personal by definition. Shared settings would go in
# .claude/settings.json, which stays trackable.
.claude/settings.local.json
.claude/launch.json

# Node / clients
node_modules/
clients/**/dist/
clients/**/src-tauri/target/

# Downloaded release artifacts (built by CI, not source)
dist-release/

# PyInstaller sidecar build output
backend/dist-sidecar/
backend/build-sidecar/
backend/*.spec.bak
clients/desktop/src-tauri/binaries/
# Tauri regenerates gen/schemas on every cargo build; committing it just makes
# every local build show up as a diff.
clients/desktop/src-tauri/gen/
