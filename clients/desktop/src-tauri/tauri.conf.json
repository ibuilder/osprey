{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osprey",
  "version": "0.1.0",
  "identifier": "dev.ospreyhq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Osprey",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 ws://localhost:8000 https://*"
    },
    "trayIcon": {
      "id": "osprey-tray",
      "iconPath": "icons/tray.png",
      "tooltip": "Osprey — the foreman that never sleeps"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
