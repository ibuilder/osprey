{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osprey",
  "version": "0.2.0",
  "identifier": "dev.ospreyhq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Osprey",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https://* wss://*"
    },
    "trayIcon": {
      "id": "osprey-tray",
      "iconPath": "icons/tray.png",
      "tooltip": "Osprey — the foreman that never sleeps"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/osprey-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMDk2NUVDNzA5RTI5RjkKUldUNUtaNXc3R1VKb1BaTzJIOWcxM0RCbG9Tb1NGWkcvTmQ3K0V4Mm03N05xOEJ6T3JNNkVYam8K",
      "endpoints": [
        "https://github.com/ibuilder/osprey/releases/latest/download/latest.json"
      ]
    }
  }
}
